---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { link } from '../site';

const {
  title = '해원국립대학교',
  description = '해원국립대학교 공식 홈페이지 — 극시리 좀비 아포칼립스 자캐커뮤니티 안내',
  active,
  theme = 'light',
  popup = false,
} = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === 'dark' ? '#090c0b' : '#0d2a52'} />
    <title>{title} | 해원국립대학교</title>
  </head>
  <body class={theme === 'dark' ? 'theme-dark' : undefined}>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header active={active} />
    <main id="main"><slot /></main>

    <div class="foot-links">
      <div class="inner">
        <a class="strong" href={link('about/')}>대학안내</a>
        <a href={link('guide/')}>학사안내</a>
        <a href={link('calendar/')}>학사일정</a>
        <a href={link('apply/')}>모집요강</a>
        <a href={link('notice/')}>공지사항</a>
        <a href={link('notice/')}>개인정보처리방침</a>
        <a href={link('notice/')}>이메일무단수집거부</a>
      </div>
    </div>

    <footer class="site-footer">
      <div class="inner">
        <div>
          <div class="f-brand">
            <b>해원국립대학교</b>
            <span>HAEWON NATIONAL UNIVERSITY</span>
          </div>
          <address>
            (00193) 해원시 대학로 93 해원국립대학교 본관<br />
            대표전화 093-000-0093 · 상황실 093-000-9393 (24시간)<br />
            학생지원처 093-000-0111 · 의과대학 연구동 <b>회선 불통</b>
          </address>
          <p class="copy">© HAEWON NATIONAL UNIVERSITY. ALL RIGHTS RESERVED.</p>
        </div>
        <div class="f-right">
          <select class="family-select" aria-label="관련 기관 바로가기">
            <option>관련 기관 바로가기</option>
            <option>해원시 재난안전대책본부</option>
            <option>질병관리본부 감염병관리과</option>
            <option>해원대학교병원</option>
            <option>의과대학 백신연구팀</option>
          </select>
          <span class="f-badge">최종 갱신 <b>D+93</b> 이후 갱신 없음</span>
        </div>
      </div>
    </footer>

    {popup && (
      <div class="popup" id="popup">
        <div class="pop-head">
          <span>[긴급] 캠퍼스 출입 안내</span>
          <button type="button" id="popup-x" aria-label="팝업 닫기">×</button>
        </div>
        <div class="pop-body">
          <strong>제93호 · 전면 폐쇄 연장</strong>
          교내 전 구역 출입이 통제되고 있습니다. 잔류 인원은 학생회관 임시 거점으로 이동하시고, 야간 이동을 삼가 주시기 바랍니다.
        </div>
        <div class="pop-foot">
          <span>학생지원처</span>
          <button type="button" id="popup-close">오늘 하루 열지 않기</button>
        </div>
      </div>
    )}

    <button class="to-top" id="to-top" type="button" aria-label="맨 위로">↑</button>

    <script>
      // 등장 효과
      const revealed = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }),
          { rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
        );
        revealed.forEach((el) => observer.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('is-visible'));
      }

      // 맨 위로
      const toTop = document.getElementById('to-top');
      const onScroll = () => toTop.classList.toggle('show', window.scrollY > 500);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // 팝업 공지 (오늘 하루 열지 않기)
      const popupEl = document.getElementById('popup');
      if (popupEl) {
        const today = new Date().toDateString();
        if (localStorage.getItem('hnu-popup') === today) popupEl.hidden = true;
        document.getElementById('popup-x').addEventListener('click', () => (popupEl.hidden = true));
        document.getElementById('popup-close').addEventListener('click', () => {
          localStorage.setItem('hnu-popup', today);
          popupEl.hidden = true;
        });
      }

      // 감염 기록 타이머 (대학안내 페이지)
      const rec = document.getElementById('rec-time');
      if (rec) {
        let seconds = 17;
        setInterval(() => {
          seconds = (seconds + 1) % 60;
          rec.textContent = `● REC 00:93:${String(seconds).padStart(2, '0')}`;
        }, 1000);
      }
    </script>
  </body>
</html>
