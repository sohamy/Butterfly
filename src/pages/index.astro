---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { link } from '../site';
import { notices } from '../data/notices';

const quick = [
  [link('calendar/'), '✎', '학사일정', '1일차 ~ 12일차 운영'],
  [link('guide/'), '☰', '학사안내', '조사 · 전투 · 감염 규정'],
  [link('apply/'), '☗', '모집요강', '포지션 및 신청 절차'],
  [link('notice/category/situation/'), '✉', '상황실 알림', '093-000-9393'],
];

const latest = notices.slice(0, 6);
---
<BaseLayout title="메인" active="home" popup={true}>
  <section class="visual">
    <div class="inner">
      <div>
        <span class="visual-tag">HAEWON NATIONAL UNIVERSITY · SINCE 1953</span>
        <h1>진실을 향해,<br /><em>남은 사람들과 함께.</em></h1>
        <p>해원국립대학교 공식 홈페이지입니다. 현재 교내 전 구역은 감염병 확산에 따라 폐쇄 중이며, 잔류 인원을 위한 학사 운영만 제한적으로 유지되고 있습니다.</p>
        <div class="visual-actions">
          <a class="btn btn-primary" href={link('about/')}>대학 안내</a>
          <a class="btn btn-ghost" href={link('apply/')}>모집요강 바로가기</a>
        </div>
      </div>
      <div class="emergency-card" data-reveal>
        <header>
          <strong>긴급 상황 안내</strong>
          <span>DAY 093 기준</span>
        </header>
        <ul>
          <li><b>위기경보</b><span>심각 (최고 단계) 유지</span></li>
          <li><b>캠퍼스</b><span>전 구역 봉쇄 · 출입 통제</span></li>
          <li><b>잔류 인원</b><span>집계 불가</span></li>
          <li><b>운영 목표</b><span>백신 자료 확보 및 대피</span></li>
        </ul>
        <footer>
          <span>학생지원처 · 상황실</span>
          <span>093-000-9393</span>
        </footer>
      </div>
    </div>
  </section>

  <nav class="quick" aria-label="바로가기">
    <div class="inner">
      {quick.map(([href, icon, name, desc]) => (
        <a href={href}>
          <span class="q-icon" aria-hidden="true">{icon}</span>
          <span><strong>{name}</strong><small>{desc}</small></span>
        </a>
      ))}
    </div>
  </nav>

  <section class="section">
    <div class="inner">
      <SectionTitle
        code="NOTICE"
        title="공지사항"
        subtitle="교내 상황 및 학사 운영에 관한 안내입니다."
        more={{ href: link('notice/'), label: '전체보기' }}
      />
      <div class="board-grid">
        <div class="board" data-reveal>
          <h3>학교 소식</h3>
          <ul>
            {latest.map((notice) => (
              <li>
                {notice.fixed
                  ? <span class="badge imp">중요</span>
                  : notice.isNew && <span class="badge new">NEW</span>}
                <a href={link(`notice/view/${notice.id}/`)}>{notice.title}</a>
                <time>{notice.date}</time>
              </li>
            ))}
          </ul>
        </div>
        <div class="notice-side">
          <div class="side-card dark" data-reveal>
            <h3>참가 신청 안내</h3>
            <p>포지션 선점 순으로 접수하며, 캐릭터 설정은 세계관과 충돌하지 않는 범위에서 자유롭게 작성할 수 있습니다.</p>
            <a class="link" href={link('apply/#step')}>신청 절차 확인</a>
          </div>
          <div class="side-card" data-reveal>
            <h3>주요 연락처</h3>
            <ul class="contact-list">
              <li><b>상황실</b><span>093-000-9393</span></li>
              <li><b>학생지원처</b><span>093-000-0111</span></li>
              <li><b>보건진료소</b><span>093-000-0119</span></li>
              <li><b>의과대학 연구동</b><span>회선 불통</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="world-teaser">
    <div class="tape" aria-hidden="true"></div>
    <div class="t-noise" aria-hidden="true"></div>
    <div class="inner">
      <div>
        <span class="eng"><i></i>EMERGENCY BROADCAST — DAY 093</span>
        <h2>학교 안내를 열기 전에,<br />이곳이 어떤 곳이 되었는지부터.</h2>
        <p>대학안내 페이지에는 봉쇄 이후의 기록이 그대로 남아 있습니다.</p>
      </div>
      <a class="btn-dark" href={link('about/')}>감염 기록 열람</a>
    </div>
    <div class="tape" aria-hidden="true"></div>
  </section>
</BaseLayout>
