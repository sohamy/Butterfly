---
import SubLayout from '../layouts/SubLayout.astro';

const systems = [
  ['01', '조사', '개방된 구역을 수색해 백신 재료, 의약품, 무기, 기록, 먼저 들어간 생존자의 흔적을 확보합니다. 구역은 학사일정에 따라 순차적으로 개방됩니다.'],
  ['02', '전투', '감염체와 조우하면 전투 판정이 발생합니다. 결과는 무사 생환 · 경상 · 중상 · 물림 · 사망 다섯 단계이며, 동행자의 판정이 서로에게 영향을 줍니다.'],
  ['03', '감염', '물림과 감염 혈액 노출은 감염 판정을 부릅니다. 잠복기에는 본인도 알아차리지 못하며, 억제제로 진행을 늦출 수는 있어도 되돌릴 수는 없습니다.'],
  ['04', '백신', '혈액 샘플, 연구 기록, 항체 데이터, 합성 시약, 가동 가능한 연구시설. 다섯 항목이 모두 모여야 완성에 도달할 수 있습니다.'],
  ['05', '아이템', '응급처치 키트, 억제제, 방호복, 무기, 출입 카드. 소지품은 조사 범위와 생존 확률에 직접 반영되며 참가자 간 양도가 가능합니다.'],
  ['06', '엔딩', '백신 · 탈출 · 희생 · 전멸 · 진실 · 은폐. 확보한 정보량과 마지막 날의 선택이 각자의 결말을 나눕니다.'],
];

const infection = [
  ['잠복', '자각 증상 없음. 본인도 감염 사실을 알 수 없습니다.'],
  ['초기 증상', '미열과 어지럼증. 정신 판정에 불이익이 붙기 시작합니다.'],
  ['진행', '상처 부위 변색. 억제제 없이는 하루 단위로 악화됩니다.'],
  ['말기', '의식 혼탁. 전투 및 조사 참여가 제한됩니다.'],
  ['완전 변이', '캐릭터 사망 처리. 이후 감염체로 등장할 수 있습니다.'],
];

const stats = [
  ['힘', '근접 공격력 · 문을 부수거나 물체를 옮기는 완력', '0 – 5'],
  ['민첩', '회피 · 도주 · 은신 이동', '0 – 5'],
  ['정신', '감염 저항 · 공포와 패닉 극복', '0 – 5'],
  ['지식', '기록 해독 · 응급처치 · 연구 자료 해석', '0 – 5'],
  ['운', '아이템 발견 · 최악의 판정을 비껴가는 확률', '0 – 5'],
];
---
<SubLayout
  title="학사안내"
  eng="ACADEMICS"
  desc="조사와 전투, 감염 판정까지 — 참가 전 반드시 확인해야 할 운영 규정입니다."
  active="guide"
  accent="v-guide"
  current="운영 시스템"
>
  <div class="page-title">
    <h2>운영 시스템</h2>
    <span class="util">최종 개정 DAY 093</span>
  </div>

  <div class="notice-strip" data-reveal>
    <b>필독</b>
    <span>본 커뮤니티에는 조사, 전투, 부상, 감염, 캐릭터 사망 요소가 포함되어 있습니다.</span>
  </div>

  <section class="block" id="system">
    <h3>여섯 가지 기본 시스템</h3>
    <p class="lead">생존은 수치가 아니라 선택으로 결정됩니다. 각 시스템은 서로 맞물려 작동합니다.</p>
    <div class="guide-grid">
      {systems.map(([no, name, text]) => (
        <article class="guide-card" data-reveal>
          <span class="no">SYSTEM {no}</span>
          <h4>{name}</h4>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="block" id="infection">
    <h3>감염 진행 단계</h3>
    <p class="lead">감염은 다섯 단계로 악화되며, 되돌릴 수 없습니다.</p>
    <div class="stage-flow" data-reveal>
      <span class="stage"><b></b>잠복</span>
      <span class="arrow" aria-hidden="true">›</span>
      <span class="stage"><b></b>초기 증상</span>
      <span class="arrow" aria-hidden="true">›</span>
      <span class="stage"><b></b>진행</span>
      <span class="arrow" aria-hidden="true">›</span>
      <span class="stage"><b></b>말기</span>
      <span class="arrow" aria-hidden="true">›</span>
      <span class="stage"><b></b>완전 변이</span>
    </div>
    <div class="table-wrap" style="margin-top:18px" data-reveal>
      <table class="board-table">
        <thead>
          <tr><th style="width:150px">단계</th><th>증상 및 적용</th></tr>
        </thead>
        <tbody>
          {infection.map(([name, desc]) => (
            <tr><td><b>{name}</b></td><td>{desc}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="block" id="stats">
    <h3>능력치 배분</h3>
    <p class="lead">기본 5개 항목에 자유롭게 배분합니다.</p>
    <div class="table-wrap" data-reveal>
      <table class="board-table">
        <thead>
          <tr><th style="width:130px">항목</th><th>적용 범위</th><th style="width:110px">배분 범위</th></tr>
        </thead>
        <tbody>
          {stats.map(([name, effect, range]) => (
            <tr><td><b>{name}</b></td><td>{effect}</td><td class="num">{range}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="calendar-note" data-reveal>
      <b>참고</b>
      <span>군인 포지션은 힘을, 연구원 포지션은 지식을 최대 10까지 설정할 수 있습니다. 그 외 항목은 포지션과 무관하게 동일한 기준이 적용됩니다.</span>
    </div>
  </section>
</SubLayout>
