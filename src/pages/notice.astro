---
import SubLayout from '../layouts/SubLayout.astro';

const fixed = [
  ['[긴급] 교내 전 구역 출입 통제 연장 안내 (제93호)', '상황실', '2025.09.14'],
  ['[필독] 물림 및 혈액 접촉 발생 시 신고 절차', '보건진료소', '2025.09.10'],
];

const list = [
  [28, '학생회관 임시 거점 운영 및 물자 배분 지침', '학생지원처', '2025.09.13', true],
  [27, '현장조사 참가 신청 및 판정 접수 방법 안내', '학사운영팀', '2025.09.12', true],
  [26, '중앙도서관 부분 개방에 따른 열람 제한 사항', '중앙도서관', '2025.09.11', false],
  [25, '야간 이동 금지 및 소음 최소화 권고', '상황실', '2025.09.09', false],
  [24, '휴업 기간(09.08~09.14) 운영 중단 안내', '학사운영팀', '2025.09.07', false],
  [23, '의과대학 연구동 출입 카드 재발급 중단 안내', '학사운영팀', '2025.09.06', false],
  [22, '대학병원 진입로 확보 작업 결과 보고', '상황실', '2025.09.05', false],
  [21, '감염 의심 증상 자가 점검표 배포', '보건진료소', '2025.09.04', false],
  [20, '학생회장 부재에 따른 학생회 업무 이관 안내', '학생지원처', '2025.09.03', false],
  [19, '비상 급수 및 배급 시간 변경 안내', '총무팀', '2025.09.02', false],
];
---
<SubLayout
  title="공지사항"
  eng="NOTICE"
  desc="교내 상황 및 학사 운영에 관한 안내입니다."
  active="notice"
  accent="v-notice"
  current="전체 공지"
>
  <div class="page-title">
    <h2>전체 공지</h2>
    <span class="util">최종 갱신 2025.09.14</span>
  </div>

  <div class="search-bar" data-reveal>
    <span class="total">전체 <b>28</b>건 · 1 / 3 페이지</span>
    <form onsubmit="return false">
      <select aria-label="검색 분류">
        <option>제목</option>
        <option>작성 부서</option>
        <option>내용</option>
      </select>
      <input type="search" placeholder="검색어를 입력하세요" aria-label="검색어" />
      <button type="submit">검색</button>
    </form>
  </div>

  <div class="table-wrap" id="list" data-reveal>
    <table class="board-table list-table">
      <thead>
        <tr>
          <th style="width:80px">번호</th>
          <th>제목</th>
          <th style="width:130px">작성 부서</th>
          <th style="width:120px">등록일</th>
        </tr>
      </thead>
      <tbody>
        {fixed.map(([title, dept, date]) => (
          <tr class="fixed">
            <td class="center"><span class="badge imp">공지</span></td>
            <td class="subject"><a href="#list">{title}</a></td>
            <td class="center">{dept}</td>
            <td class="center">{date}</td>
          </tr>
        ))}
        {list.map(([no, title, dept, date, isNew]) => (
          <tr>
            <td class="center">{no}</td>
            <td class="subject">
              <a href="#list">{title}</a>
              {isNew && <span class="badge new">NEW</span>}
            </td>
            <td class="center">{dept}</td>
            <td class="center">{date}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <nav class="pager" aria-label="페이지 이동">
    <a href="#list">‹</a>
    <span class="on">1</span>
    <a href="#list">2</a>
    <a href="#list">3</a>
    <a href="#list">›</a>
  </nav>

  <div class="calendar-note" data-reveal>
    <b>문의</b>
    <span>공지 내용에 관한 문의는 상황실(093-000-9393) 또는 학생지원처(093-000-0111)로 연락해 주세요. 야간에는 상황실만 운영됩니다.</span>
  </div>
</SubLayout>
